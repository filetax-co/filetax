# Environment variables - NEVER commit these
.env
.env.local
.env.*.local
.env.development
.env.production

# Dependencies
node_modules/

# Build output
dist/
build/
.next/

# Misc
.DS_Store
*.log

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# transient esbuild stubs from verify scripts
scripts/_sb*.ts
scripts/_supabaseStub.ts

# local harness state
.claude/

# macOS metadata
._*
.DS_Store

# git bundles
*.bundle

# Scratch output from npm run verify:pdf
tmp-verify/

# End-to-end run artifacts: captured PDFs, per-scenario results and the
# workbook. Regenerated by a run, ~130MB, and meaningless outside the machine
# that produced them.
testing/run-*/

# Scratch PNG renders from ad-hoc PDF inspection
tmp/
