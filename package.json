{
  "name": "filetax-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/copyPdfjsAssets.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:spa": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "predev": "node scripts/copyPdfjsAssets.mjs",
    "dev": "vite",
    "predev:e2e": "node scripts/copyPdfjsAssets.mjs",
    "dev:e2e": "vite",
    "gen:scenarios100b": "node scripts/genScenarios100.mjs",
    "report:e2e": "node scripts/e2eReport.mjs",
    "audit:pdfs": "node scripts/audit-pdf-fields.mjs",
    "gen:samples": "esbuild scripts/genSamplePreview.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env={\\\"BASE_URL\\\":\\\"/\\\"} --outfile=tmp-verify/genSample.mjs --log-level=error && node tmp-verify/genSample.mjs && node scripts/rasterSamplePreview.mjs && npm run gen:samples:rcl",
    "gen:samples:rcl": "esbuild scripts/genSampleRcl.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env={\\\"BASE_URL\\\":\\\"/\\\"} --outfile=tmp-verify/genRcl.mjs --log-level=error && node tmp-verify/genRcl.mjs",
    "typecheck": "tsc --noEmit",
    "verify:logic": "node --experimental-strip-types --import ./scripts/tsResolve.mjs scripts/verifyRegressions.mjs",
    "verify:pdf": "esbuild scripts/verifyPackageOutput.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env={\\\"BASE_URL\\\":\\\"/\\\"} --outfile=tmp-verify/verifyPackage.mjs --log-level=error && node tmp-verify/verifyPackage.mjs",
    "verify:7004": "node scripts/verify7004.mjs",
    "verify:pagesize": "node scripts/verifyPageSize.mjs",
    "verify:fields": "node scripts/verifyFieldPositions.mjs",
    "verify:structure": "node scripts/verifyPdfStructure.mjs",
    "verify:prices": "node scripts/checkPriceLiterals.mjs",
    "verify:anchors": "node scripts/verifyErrorAnchors.mjs",
    "test": "npm run typecheck && npm run verify:logic && npm run verify:pdf && npm run verify:7004 && npm run verify:pagesize && npm run verify:fields && npm run verify:structure && npm run verify:prices && npm run verify:anchors",
    "seed": "esbuild scripts/seedScenarios.mjs --bundle --platform=node --format=esm --packages=external --outfile=tmp-verify/seed.mjs --log-level=error && node tmp-verify/seed.mjs",
    "gen:scenarios": "node scripts/genScenarios.mjs",
    "gen:scenarios3": "node scripts/genScenarios3.mjs ../../Testing/filetax_test_scenarios_v3.json",
    "gen:scenarios100": "npm run gen:scenarios3 && node scripts/mergeScenarios.mjs",
    "seed:guide": "esbuild scripts/seedGuideFixture.mjs --bundle --platform=node --format=esm --packages=external --outfile=tmp-verify/seedGuide.mjs --log-level=error && node tmp-verify/seedGuide.mjs",
    "shots:guide": "node scripts/captureGuideShots.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
